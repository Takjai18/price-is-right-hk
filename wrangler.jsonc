{
  "name": "price-is-right-hk",
  "account_id": "db0374b37171e14e52b085a4b4f0d1dc",
  "main": "worker.js",
  "compatibility_date": "2026-10-26",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "PRICE_ROOM", "class_name": "PriceRoomDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PriceRoomDO"] }
  ]
}
